# Copy the secret lines into .dev.vars for `wrangler pages dev`.
# Production secrets:
#   wrangler pages secret put GEMINI_API_KEY
#   wrangler pages secret put TURNSTILE_SECRET

GEMINI_API_KEY=
# Cloudflare's official dummy secret. It always passes siteverify.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Optional. Defaults are in wrangler.toml.
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high. Omit to keep the model default (minimal on gemini-3.5-flash-lite).
GEMINI_THINKING_LEVEL=
# Set to re-run once when validation reports 3 or more errors.
GEMINI_ESCALATION_MODEL=
# free hides nothing: the upload warning is shown. paid hides the warning.
GEMINI_DATA_TERMS=free
DAILY_CAP=100
TURNSTILE_SITE_KEY=1x00000000000000000000AA
