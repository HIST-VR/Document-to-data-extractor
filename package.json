{
  "name": "doclens-ua",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --port 5173 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
